{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tsc/web",
    "paths": { "@renderer/*": ["./src/renderer/src/*"] }
  },
  "include": ["src/renderer/src", "src/shared", "src/core", "src/preload/index.ts"]
}
